# --- Server ---
PORT=8787
# Exact browser origin allowed by CORS (the Vite dev server by default)
FRONTEND_ORIGIN=http://localhost:5173

# --- Synthesia (server-only, never shipped to the browser) ---
# API key with the `interactive_avatars` scope
SYNTHESIA_API_KEY=
# One to five Interactive Avatar ids (bare UUID or av_-prefixed), comma-separated. Must be accessible
# to the API key's workspace. Default is the quickstart's "Jenny", which works on every workspace.
SYNTHESIA_AVATAR_ID=8788bef1-8020-46e0-a8f4-510ea9989b25
# SYNTHESIA_API_URL=https://developers.synthesia.io
# SYNTHESIA_AVATAR_IDENTITY=synthesia-avatar-agent

# --- LiveKit (server-only) ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- TTS (server-only). Synthesia has no voice of its own; the avatar lip-syncs this audio. ---
# TTS_PROVIDER=elevenlabs|openai (default: elevenlabs if ELEVENLABS_API_KEY is set, else openai)
ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL=eleven_flash_v2_5
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
# OPENAI_API_KEY=
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=alloy

# --- Limits ---
# ROOM_EMPTY_TIMEOUT_SEC=60
# MAX_SESSION_MINUTES=30
